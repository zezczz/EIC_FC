# EIC FC 环境变量示例
# 复制为 .env.local 并按需修改；本文件只能包含名称和示例，不得包含真实密钥。

# --- 应用 ---
NODE_ENV=development
# 本机开发用 localhost。生产解析域名后改为 https://czzczzzez.cloud
APP_URL=http://localhost:3000
# 生产必须使用强随机值: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret
# 允许的来源，逗号分隔。本机可只留 localhost；上线同时加上域名
TRUSTED_ORIGINS=http://localhost:3000,http://47.109.110.141,http://czzczzzez.cloud,https://czzczzzez.cloud,https://www.czzczzzez.cloud
TZ=Asia/Shanghai

# --- 数据库 ---
DATABASE_URL=postgresql://eicfc:eicfc_dev_password@localhost:5432/eicfc
# 直连 URL（迁移/脚本使用，指向同一数据库）
DIRECT_URL=postgresql://eicfc:eicfc_dev_password@localhost:5432/eicfc

# --- 对象存储 (开发 MinIO；生产可用本机 MinIO 或云 OSS/COS) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eicfc
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# 浏览器预签名使用该 URL 的 origin。
# 本机 next dev：http://localhost:9000/eicfc
# 本机/服务器走 Caddy：http://localhost/eicfc
# 生产解析域名后：https://czzczzzez.cloud/eicfc
S3_PUBLIC_BASE_URL=http://localhost:9000/eicfc
S3_FORCE_PATH_STYLE=true

# --- 生产 Compose（仅服务器 .env，不要提交真实值）---
# POSTGRES_USER=eicfc
# POSTGRES_PASSWORD=replace-with-a-random-password
# POSTGRES_DB=eicfc
# CADDY_ACME_EMAIL=admin@example.com

# --- 媒体限制 ---
MAX_IMAGE_BYTES=8388608
MAX_IMAGE_PIXELS=40000000

# --- 日志 ---
LOG_LEVEL=info
# 生产经 Caddy 反代时设为 true，以信任 X-Forwarded-For
TRUST_PROXY=false

# --- 备份（生产配置，异地对象存储）---
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
